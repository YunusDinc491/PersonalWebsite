<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Yunus Dinç</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tektur:wght@400..900&family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/design.css" asp-append-version="true" />
</head>
<body>

    <div class="noise"></div>

    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">YUNUS DİNÇ / 2026</a>
        <nav class="topbar-nav">
            <a class="nav-btn" asp-controller="Projeler" asp-action="Index">Projelerim</a>
            <a class="nav-btn" asp-controller="BeniIseAl" asp-action="Index">Beni İşe Al!</a>
        </nav>
        <span class="status"><span class="dot"></span>AVAILABLE FOR JOB OR INTERN</span>
    </header>

    @RenderBody()

    <footer class="site-footer">
        <span>YUNUS DINÇ / 2026</span>
        <span>Tüm hakları saklıdır.</span>
    </footer>

    <script src="~/js/design.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>